# Copy to .env and fill in. Never commit .env.
# (Variables are added here as services are introduced.)

# api
PORT=3000
# Postgres from `docker compose up -d db`
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ragchat
# Which model provider answers and embeds: google (default, free tier) or openai.
# Vectors from different embedding models are not comparable: after switching, documents indexed
# earlier are not searched (the API logs how many at start); upload them again.
# AI_PROVIDER=google
# Gemini key from https://aistudio.google.com/apikey (AI_PROVIDER=google). Without it the app runs,
# but documents cannot be indexed and chat cannot answer.
GOOGLE_GENERATIVE_AI_API_KEY=
# OpenAI key from https://platform.openai.com/api-keys (AI_PROVIDER=openai). It needs API credit;
# a ChatGPT subscription does not include it.
# OPENAI_API_KEY=
# Model names default to the provider's own: gemini-embedding-001 / gemini-3.5-flash-lite for google,
# text-embedding-3-small (cut to 768 dimensions) / gpt-5-nano for openai. Set them to override.
# EMBEDDING_MODEL=
# Embedding tokens sent per minute when indexing documents; the app stays below this value and
# waits when a large document would exceed it. Defaults: 25000 for google (the free tier allows
# 30,000), 200000 for openai (free accounts allow 40,000, paid ones 1,000,000).
# EMBEDDING_TOKENS_PER_MINUTE=
# Small model that turns follow-up questions into standalone search queries (must accept the
# lowest reasoning level, e.g. the Flash-Lite family or gpt-5-nano).
# REWRITE_MODEL=
# Minimum cosine similarity (0..1) of the best passage for the model to be asked at all; below it
# the app answers "not found" itself. Measured with gemini-embedding-001: unrelated questions
# reach 0.50-0.60, answerable ones 0.68 and up. Re-check if the embedding model changes.
# RELEVANCE_THRESHOLD=0.65
# Model that writes the answers. Flash-Lite is the google default because the larger Flash models
# are often overloaded on the free tier. CHAT_THINKING_LEVEL (reasoning effort for openai) must be
# one the model accepts (minimal | low | medium | high; gemini-3.8-flash rejects minimal).
# CHAT_MODEL=
# CHAT_THINKING_LEVEL=minimal
# Questions one user may ask per minute and per day. Every question costs several model calls
# from one shared quota, so this keeps a single account from using it all up.
# CHAT_RATE_LIMIT_PER_MINUTE=10
# CHAT_RATE_LIMIT_PER_DAY=150
# Used only by `npm run eval:faithfulness`: the model that grades the answers (defaults to CHAT_MODEL;
# a different or stronger model is a fairer judge) and how much it may think.
# EVAL_JUDGE_MODEL=
# EVAL_JUDGE_THINKING_LEVEL=low
# Session cookie over HTTPS only. Defaults to true in production, false otherwise.
# COOKIE_SECURE=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
