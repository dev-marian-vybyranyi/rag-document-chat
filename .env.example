# Copy to .env and fill in. Never commit .env.
# (Variables are added here as services are introduced.)

# api
PORT=3000
# Postgres from `docker compose up -d db`
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ragchat
# Gemini key from https://aistudio.google.com/apikey. Without it the app runs, but documents
# cannot be indexed and chat cannot answer.
GOOGLE_GENERATIVE_AI_API_KEY=
# EMBEDDING_MODEL=gemini-embedding-001
# Small model that turns follow-up questions into standalone search queries (must accept
# thinkingLevel "minimal", e.g. the Flash-Lite family).
# REWRITE_MODEL=gemini-3.5-flash-lite
# Session cookie over HTTPS only. Defaults to true in production, false otherwise.
# COOKIE_SECURE=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
