# Copy to .env and fill in. Never commit .env.
# (Variables are added here as services are introduced.)

# api
PORT=3000
# Postgres from `docker compose up -d db`
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ragchat
# Gemini key from https://aistudio.google.com/apikey. Without it the app runs, but documents
# cannot be indexed and chat cannot answer.
GOOGLE_GENERATIVE_AI_API_KEY=
# EMBEDDING_MODEL=gemini-embedding-001
# Small model that turns follow-up questions into standalone search queries (must accept
# thinkingLevel "minimal", e.g. the Flash-Lite family).
# REWRITE_MODEL=gemini-3.5-flash-lite
# Minimum cosine similarity (0..1) of the best passage for the model to be asked at all; below it
# the app answers "not found" itself. Measured with gemini-embedding-001: unrelated questions
# reach 0.50-0.60, answerable ones 0.68 and up. Re-check if the embedding model changes.
# RELEVANCE_THRESHOLD=0.65
# Model that writes the answers. Flash-Lite is the default because the larger Flash models are
# often overloaded on the free tier. CHAT_THINKING_LEVEL must be one the model accepts
# (minimal | low | medium | high; gemini-3.8-flash rejects minimal).
# CHAT_MODEL=gemini-3.5-flash-lite
# CHAT_THINKING_LEVEL=minimal
# Questions one user may ask per minute and per day. Every question costs several Gemini calls
# from one shared free-tier quota, so this keeps a single account from using it all up.
# CHAT_RATE_LIMIT_PER_MINUTE=10
# CHAT_RATE_LIMIT_PER_DAY=150
# Session cookie over HTTPS only. Defaults to true in production, false otherwise.
# COOKIE_SECURE=false
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
