# Rendered at container start: the official nginx image runs envsubst over
# /etc/nginx/templates/*.template, filling in PORT and API_UPSTREAM.
server {
  listen ${PORT};
  server_name _;

  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  add_header X-Content-Type-Options nosniff always;
  add_header X-Frame-Options DENY always;
  add_header Referrer-Policy strict-origin-when-cross-origin always;

  # The browser only ever talks to this origin. /api/* is forwarded to the API
  # with the prefix stripped (trailing slash in proxy_pass), and the generated
  # request id is passed on so one id follows a request through both services.
  location /api/ {
    proxy_pass ${API_UPSTREAM}/;
    proxy_http_version 1.1;
    # Host is deliberately left at nginx's default ($proxy_host = the upstream's own name):
    # Render routes public traffic by Host header, so forwarding ours would miss the API.
    # SNI is required to reach an HTTPS upstream such as https://<service>.onrender.com.
    proxy_ssl_server_name on;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id $request_id;
    # Streamed chat responses must not be buffered or they arrive in one piece.
    proxy_buffering off;
    proxy_read_timeout 300s;
  }

  # Hashed build assets can be cached forever.
  location /assets/ {
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # Client-side routing: unknown paths fall back to the SPA entry point.
  location / {
    try_files $uri /index.html;
  }
}
