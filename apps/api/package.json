{
  "name": "@rag-chat/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "check:embeddings": "tsx --env-file-if-exists=../../.env scripts/check-embeddings.ts",
    "eval:retrieval": "tsx --env-file-if-exists=../../.env scripts/eval-retrieval.ts",
    "eval:code": "tsx --env-file-if-exists=../../.env scripts/eval-code.ts",
    "eval:faithfulness": "tsx --env-file-if-exists=../../.env scripts/eval-faithfulness.ts"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/yauzl": "^3.4.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.88",
    "@ai-sdk/openai": "^4.0.89",
    "ai": "^7.0.128",
    "cookie-parser": "^1.4.7",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "multer": "^2.4.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "unpdf": "^1.8.1",
    "yauzl": "^3.4.0",
    "zod": "^4.6.5"
  }
}
